# ---------------------------------------------------------------
# BHOOMI-DRISHTI - local development environment template
#
# Copy this file to `.env` (same folder) and adjust the values.
# Never commit the real `.env` file - it is ignored by .gitignore.
#
# Who reads this file?
#   * Docker Compose            -> reads `.env` automatically (docker compose up -d)
#   * Spring Boot backend       -> reads it through spring.config.import (backend/src/main/resources/application.yml)
#   * Vite frontend             -> reads it from this folder through envDir (frontend/vite.config.ts)
#
# Every value below is a local development default. Do not use these
# credentials outside your own machine.
# ---------------------------------------------------------------

# ---- PostgreSQL + PostGIS (Docker Compose) ----
DATABASE_NAME=bhoomi_drishti
DATABASE_USER=bhoomi
DATABASE_PASSWORD=change_me
DATABASE_PORT=5432

# ---- Backend (Spring Boot) ----
BACKEND_PORT=8080

# ---- Frontend (Vite) ----
FRONTEND_PORT=5173
# Base URL the browser uses to reach the backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:8080
# Optional MapTiler API key for GIS base map tiles (free tier: https://cloud.maptiler.com)
# When omitted, falls back to standard OpenStreetMap tiles.
VITE_MAPTILER_KEY=

# ---- Authentication (Phase 2) ----
# HS256 signing key for access tokens - at least 32 characters, long and random.
# Generate one:  powershell -c "[guid]::NewGuid().Guid.Replace('-','')+[guid]::NewGuid().Guid.Replace('-','')"
# The development placeholder below works locally; replace it before deploying anywhere shared.
JWT_SECRET=development_only_replace_with_a_long_random_secret_32_chars
# Token lifetime in seconds (default 86400 = 24 hours).
JWT_EXPIRATION=86400

# Google OpenID Connect credentials - see docs/api/google-oauth-setup.md.
# Copy the values from Google Cloud Console here; NEVER commit real values to git and never
# paste them into source code. While these stay as placeholders, the backend starts normally and
# everything works except "Continue with Google" (it reports a sign-in failure).
GOOGLE_CLIENT_ID=not_configured
GOOGLE_CLIENT_SECRET=not_configured
